+  if (gResident) {
+   gResident->setProperty("XeGfxGOPCandidateStart", lo, 64);
+   gResident->setProperty("XeGfxGOPCandidateSpan", hi - lo, 64);
+   gResident->setProperty("XeGfxGOPPageCount", n, 32);
+   gResident->setProperty("XeGfxGOPDMPages", dm_pages, 32);
+   gResident->setProperty("XeGfxGOPPTEHash", pte_hash, 64);
