  }
+ // B0A0: direct CPU reads at DSMBASE triggered a machine-check reboot.
+ // Keep metadata available, but do not map pixels or claim a valid baseline.
+ if (gpu->configRead16(kIOPCIConfigVendorID) == 0x8086 &&
